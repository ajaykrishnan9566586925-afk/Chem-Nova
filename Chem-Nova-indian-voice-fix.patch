+          // Do not advance the lesson without speaking; use the browser's best
+          // available English voice and make the reduced guarantee explicit.
+          const fallbackVoice = liveVoices.find((v) => {
+            const lowerName = v.name.toLowerCase();
+            return (
+              v.lang.toLowerCase().replace('_', '-').startsWith('en-') &&
+              !lowerName.includes('female') &&
+              !lowerName.includes('woman')
+            );
+          });
+          if (fallbackVoice) {
+            lockedWebVoiceRef.current = fallbackVoice;
